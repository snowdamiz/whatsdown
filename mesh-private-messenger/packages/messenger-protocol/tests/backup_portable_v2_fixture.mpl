# All values are independent synthetic literals or bounded synthetic fixtures.
# No real source, code, key or archive is observed through this test-only predicate.
fn pv2_test_observation(value :: Bool) -> Bool do
  declassify(value,
    "TEST ONLY synthetic portable-v2 fixture equality and closed admission predicate; no real history, hash, key or arbitrary error is disclosed")
end

fn pv2_hex(value :: String) -> Bytes!String do
  case Bytes.from_hex(value) do
    Err(_) -> Err("pv2_fixture_hex")
    Ok(output)
  end
end

fn pv2_repeat(value :: Int, count :: Int) -> Bytes!String do
  case Bytes.repeat(value, count) do
    Err(_) -> Err("pv2_fixture_repeat")
    Ok(output)
  end
end

fn pv2_slice(value :: Bytes, offset :: Int, count :: Int) -> Bytes!String do
  case Bytes.slice(value, offset, count) do
    Err(_) -> Err("pv2_fixture_slice")
    Ok(output)
  end
end

fn pv2_join(parts :: List<Bytes>) -> Bytes!String do
  case Bytes.concat_many(parts, 16796865) do
    Err(_) -> Err("pv2_fixture_join")
    Ok(output)
  end
end

fn pv2_replace(value :: Bytes, offset :: Int, replacement :: Bytes) -> Bytes!String do
  pv2_join([
    pv2_slice(value, 0, offset)?,
    replacement,
    pv2_slice(value,
      offset + Bytes.length(replacement),
      Bytes.length(value) - offset - Bytes.length(replacement))?
  ])
end

pub fn portable_v2_fixture_code() -> String do
  "MRC1-00010203-04050607-08090A0B-0C0D0E0F-10111213-14151617-18191A1B-1C1D1E1F-3A37D678"
end

pub fn portable_v2_fixture_payload() -> Bytes!String do
  pv2_hex("")
end

pub fn portable_v2_fixture_wire1() -> Bytes!String do
  pv2_hex("")
end

pub fn portable_v2_fixture_wire2() -> Bytes!String do
  pv2_hex("")
end

