fn pv2_content(archive :: BackupTextArchive) -> PortableBackupV2Content do
  PortableBackupV2Content {
    owner_account: archive.owner_account,
    owner_authorization_key: archive.owner_authorization_key,
    service_realm: archive.service_realm,
    candidate_count: archive.candidate_count,
    omitted_timed: archive.omitted_timed,
    omitted_unknown: archive.omitted_unknown,
    omitted_nontext: archive.omitted_nontext,
    omitted_empty: archive.omitted_empty,
    attachment_messages: archive.attachment_messages,
    scopes: archive.scopes
  }
end

pub fn portable_v2_fixture_content() -> PortableBackupV2Content!String do
  case decode_text_archive(portable_v2_fixture_payload()?) do
    Err(_) -> Err("pv2_fixture_archive")
    Ok(archive) -> Ok(pv2_content(archive))
  end
end

fn pv2_record(text :: Bytes, ordinal :: Int) -> BackupArchiveRecord!String do
  Ok(BackupArchiveRecord {
    ordinal: ordinal,
    direction: 1,
    message_id: Bytes.empty(),
    sender_account: pv2_repeat(1, 32)?,
    sender_device: pv2_repeat(3, 16)?,
    timestamp: U64.parse("17")?,
    attachment_omitted: Bytes.length(text) == 0,
    text: text
  })
end

fn pv2_bounded_content(first :: List<BackupArchiveRecord>,
  second :: List<BackupArchiveRecord>,
  records :: Int,
  attachments :: Int) -> PortableBackupV2Content!String do
  let first_scope = BackupArchiveScope {
    kind: 2,
    id: pv2_repeat(6, 32)?,
    peer: Bytes.empty(),
    name: "",
    entries: first
  }
  let scopes = if List.length(second) == 0 do
    [first_scope]
  else
    [
      first_scope,
      BackupArchiveScope {
        kind: 2,
        id: pv2_repeat(7, 32)?,
        peer: Bytes.empty(),
        name: "",
        entries: second
      }
    ]
  end
  Ok(PortableBackupV2Content {
    owner_account: pv2_repeat(1, 32)?,
    owner_authorization_key: pv2_repeat(8, 32)?,
    service_realm: pv2_repeat(9, 32)?,
    candidate_count: records,
    omitted_timed: 0,
    omitted_unknown: 0,
    omitted_nontext: 0,
    omitted_empty: 0,
    attachment_messages: attachments,
    scopes: scopes
  })
end

pub fn portable_v2_fixture_small_content(text_size :: Int) -> PortableBackupV2Content!String do
  pv2_bounded_content([pv2_record(pv2_repeat(65, text_size)?, 0)?],
    [],
    1,
    if text_size == 0 do
      1
    else
      0
    end)
end

fn pv2_max_content(extra :: Int) -> PortableBackupV2Content!String do
  let text = pv2_repeat(65, 65346)?
  let first = for ordinal in 0..256 do
    pv2_record(text, ordinal)?
  end
  pv2_bounded_content(first, [pv2_record(pv2_repeat(66, 29864 + extra)?, 0)?], 257, 0)
end

pub fn portable_v2_fixture_encode(content :: PortableBackupV2Content,
  id :: Bytes,
  time :: U64) -> Bytes!String do
  case encode_text_archive(BackupTextArchive {
    backup_id: id,
    owner_account: content.owner_account,
    owner_authorization_key: content.owner_authorization_key,
    service_realm: content.service_realm,
    created_at: time,
    candidate_count: content.candidate_count,
    omitted_timed: content.omitted_timed,
    omitted_unknown: content.omitted_unknown,
    omitted_nontext: content.omitted_nontext,
    omitted_empty: content.omitted_empty,
    attachment_messages: content.attachment_messages,
    scopes: content.scopes
  }) do
    Err(_) -> Err("pv2_fixture_archive_encode")
    Ok(payload)
  end
end

fn pv2_literal_ok(wire :: Bytes, expected :: Bytes) -> Bool do
  case restore_portable_backup(portable_v2_fixture_code(), wire) do
    Err(_) -> false
    Ok(payload) -> Bytes.secure_equals(payload, expected)
  end
end

fn pv2_roundtrip_matches(content :: PortableBackupV2Content,
  wire :: Bytes,
  payload :: Bytes,
  time :: U64,
  expected_size :: Int) -> Bool do
  case pv2_slice(wire, 38, 32) do
    Err(_) -> false
    Ok(id) -> case portable_v2_fixture_encode(content, id, time) do
      Err(_) -> false
      Ok(expected) -> Bytes.length(payload) == expected_size
        && Bytes.secure_equals(payload, expected)
        && Bytes.length(wire) == 192 + (76 * ((expected_size + 65535) / 65536)) + expected_size
    end
  end
end

fn pv2_roundtrip(content :: PortableBackupV2Content, expected_size :: Int) -> Bool do
  case U64.parse("18446744073709551615") do
    Err(_) -> false
    Ok(time) -> case create_portable_backup_v2(content, time) do
      Err(_) -> false
      Ok(created) -> case restore_portable_backup(created.recovery_code, created.wire) do
        Err(_) -> false
        Ok(payload) -> pv2_roundtrip_matches(content, created.wire, payload, time, expected_size)
      end
    end
  end
end

fn pv2_literal_raw() -> Bool!String do
  Ok(pv2_literal_ok(portable_v2_fixture_wire2()?, portable_v2_fixture_payload()?))
end

pub fn portable_v2_fixture_literals() -> Bool do
  let result = case pv2_literal_raw() do
    Err(_) -> false
    Ok(value) -> value
  end
  pv2_test_observation(result)
end

fn pv2_binding_raw() -> Bool!String do
  let good = pv2_literal_ok(portable_v2_fixture_wire2()?, portable_v2_fixture_payload()?)
  let two_file = pv2_wire2_two()?
  let expected_two_hash = pv2_hex("1bd171ac3d1649c3199277f014aa5a75dbcb73163f3c7ef388d5b55c90fac996")?
  let two_open = restore_portable_backup(portable_v2_fixture_code(), two_file)
  let two_good = case two_open do
    Err(_) -> false
    Ok(payload) -> Bytes.length(payload) == 65537
      && Bytes.secure_equals(Crypto.sha256(payload), expected_two_hash)
  end
  let last_changed = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_replace(two_file, Bytes.length(two_file) - 1, pv2_repeat(18, 1)?)?))
  let reordered = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_join([
      pv2_slice(two_file, 0, 192)?,
      pv2_slice(two_file, 65804, 77)?,
      pv2_slice(two_file, 192, 65612)?
    ])?))
  let duplicated = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_join([
      pv2_slice(two_file, 0, 192)?,
      pv2_slice(two_file, 192, 65612)?,
      pv2_slice(two_file, 192, 65612)?
    ])?))
  let truncated = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_slice(two_file, 0, Bytes.length(two_file) - 1)?))
  let mixed = Result.is_err(restore_portable_backup(portable_v2_fixture_code(), pv2_mixed_wire2()?))
  let wrong_id = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_wrong_id_wire2()?))
  let wrong_time = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_wrong_time_wire2()?))
  let changed = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_replace(portable_v2_fixture_wire2()?, 90, pv2_repeat(0, 1)?)?))
  Ok(good
    && two_good
    && last_changed
    && reordered
    && duplicated
    && truncated
    && mixed
    && wrong_id
    && wrong_time
    && changed)
end

pub fn portable_v2_fixture_binding() -> Bool do
  let result = case pv2_binding_raw() do
    Err(_) -> false
    Ok(value) -> value
  end
  pv2_test_observation(result)
end

fn pv2_dispatch_raw() -> Bool!String do
  let good1 = pv2_literal_ok(portable_v2_fixture_wire1()?, portable_v2_fixture_payload()?)
  let good2 = pv2_literal_ok(portable_v2_fixture_wire2()?, portable_v2_fixture_payload()?)
  let wrong_outer = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_replace(portable_v2_fixture_wire1()?, 0, pv2_repeat(2, 1)?)?))
  let mixed_manifest = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_replace(portable_v2_fixture_wire2()?, 8, pv2_repeat(1, 1)?)?))
  let noncanonical_nonce = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_replace(portable_v2_fixture_wire2()?, 70, pv2_repeat(1, 1)?)?))
  let wrong_inner = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_wrong_manifest_version()?))
  let unknown = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_replace(portable_v2_fixture_wire2()?, 0, pv2_repeat(3, 1)?)?))
  let trailing = Result.is_err(restore_portable_backup(portable_v2_fixture_code(),
    pv2_join([portable_v2_fixture_wire2()?, Bytes.from_utf8("x")])?))
  Ok(good1
    && good2
    && wrong_outer
    && mixed_manifest
    && noncanonical_nonce
    && wrong_inner
    && unknown
    && trailing)
end

pub fn portable_v2_fixture_dispatch() -> Bool do
  let result = case pv2_dispatch_raw() do
    Err(_) -> false
    Ok(value) -> value
  end
  pv2_test_observation(result)
end

fn pv2_bounds_raw() -> Bool!String do
  let minimum = pv2_roundtrip(portable_v2_fixture_small_content(0)?, 293)
  let one = pv2_roundtrip(portable_v2_fixture_small_content(65243)?, 65536)
  let two = pv2_roundtrip(portable_v2_fixture_small_content(65244)?, 65537)
  let maximum = pv2_roundtrip(pv2_max_content(0)?, 16777216)
  let over = Result.is_err(create_portable_backup_v2(pv2_max_content(1)?, U64.parse("125")?))
  let empty = Result.is_err(create_portable_backup_v2(pv2_bounded_content([], [], 0, 0)?,
    U64.parse("125")?))
  Ok(minimum && one && two && maximum && over && empty)
end

pub fn portable_v2_fixture_bounds() -> Bool do
  let result = case pv2_bounds_raw() do
    Err(_) -> false
    Ok(value) -> value
  end
  pv2_test_observation(result)
end

fn pv2_oneuse_raw() -> Bool!String do
  let content = portable_v2_fixture_content()?
  let time = U64.parse("125")?
  let first = create_portable_backup_v2(content, time)
  let second = create_portable_backup_v2(content, time)
  case (first, second) do
    (Ok(a), Ok(b)) -> do
      let aid = pv2_slice(a.wire, 38, 32)?
      let bid = pv2_slice(b.wire, 38, 32)?
      let asalt = pv2_slice(a.wire, 13, 16)?
      let bsalt = pv2_slice(b.wire, 13, 16)?
      let expected = portable_v2_fixture_encode(content, aid, time)?
      let recovered = case restore_portable_backup(a.recovery_code, a.wire) do
        Err(_) -> false
        Ok(payload) -> Bytes.secure_equals(payload, expected)
      end
      let refused = Result.is_err(restore_portable_backup(b.recovery_code, a.wire))
      let retry = case restore_portable_backup(a.recovery_code, a.wire) do
        Err(_) -> false
        Ok(payload) -> Bytes.secure_equals(payload, expected)
      end
      Ok(a.recovery_code != b.recovery_code
        && !Bytes.secure_equals(aid, bid)
        && !Bytes.secure_equals(asalt, bsalt)
        && recovered
        && refused
        && retry)
    end
    _ -> Ok(false)
  end
end

pub fn portable_v2_fixture_oneuse() -> Bool do
  let result = case pv2_oneuse_raw() do
    Err(_) -> false
    Ok(value) -> value
  end
  pv2_test_observation(result)
end

fn pv2_private_raw() -> Bool!String do
  let content :: Plaintext<PortableBackupV2Content> = portable_v2_fixture_content()?
  case create_portable_backup_v2(content, U64.parse("125")?) do
    Err(_) -> Ok(false)
    Ok(created) -> do
      let id = pv2_slice(created.wire, 38, 32)?
      let expected = portable_v2_fixture_encode(content, id, U64.parse("125")?)
      let opened = restore_portable_backup(created.recovery_code, created.wire)
      let refused = Result.is_err(restore_portable_backup(portable_v2_fixture_code(), created.wire))
      let retried = restore_portable_backup(created.recovery_code, created.wire)
      case (expected, opened, retried) do
        (Ok(want), Ok(actual), Ok(again)) ->
          Ok(Bytes.secure_equals(actual, want) && refused && Bytes.secure_equals(again, want))
        _ -> Ok(false)
      end
    end
  end
end

pub fn portable_v2_fixture_private() -> Bool do
  let result = case pv2_private_raw() do
    Err(_) -> false
    Ok(value) -> value
  end
  pv2_test_observation(result)
end
