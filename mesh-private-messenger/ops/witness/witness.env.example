# /etc/morse-witness/witness.env (0644). The seed goes in seed.env (0600):
#   MESSENGER_WITNESS_SIGNING_SEED_HEX=<64 hex, from the key ceremony>
MESSENGER_BASE_URL=<the directory origin: the release pipeline's MORSE_BACKEND_URL>
MESSENGER_WITNESS_ID=witness-c
MESSENGER_WITNESS_PUBLIC_KEY_HEX=<64 hex, the public key from the key ceremony>
MESSENGER_TRANSPARENCY_PUBLIC_KEY_HEX=<64 hex, the log's service key from the security config>
MESSENGER_WITNESS_RELAY_URLS=
# First start only (remove once the witness has signed): new-identity, or the
# hex checkpoint to continue from when moving an existing witness.
MESSENGER_WITNESS_INITIAL_CHECKPOINT_HEX=new-identity
