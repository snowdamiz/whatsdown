# Copy outside the repository, chmod 0600, and fill all placeholders.
# Keep the service off until the release and native gates are complete.
MORSE_CREDITS_MODE=off
# Independent settlement switch. See ops/credit-treasury/OPERATIONS.md.
MORSE_TREASURY_MODE=off
# Independent invoice configuration. See ops/credit-lightning/OPERATIONS.md.
MORSE_LIGHTNING_MODE=off
MESSENGER_CREDIT_LIGHTNING_ORIGIN=https://lnd.example
MESSENGER_CREDIT_LIGHTNING_NETWORK=mainnet
MESSENGER_CREDIT_LIGHTNING_NODE_PUBLIC_KEY=REPLACE_WITH_PINNED_COMPRESSED_NODE_KEY_HEX
MESSENGER_CREDIT_LIGHTNING_MACAROON_HEX=REPLACE_WITH_RESTRICTED_INVOICE_CREDENTIAL_HEX
MESSENGER_CREDIT_BTC_PRICE_ACCOUNT=REPLACE_WITH_PINNED_PYTH_BTC_USD_ACCOUNT
MESSENGER_CREDITS_PURPOSE=live
MESSENGER_ISSUER_DATABASE_URL=postgres://issuer:REPLACE@issuer-database.example/issuer?sslmode=verify-full
# Compose env files support single-quoted multiline values. Paste the exact
# signed native v3+ security configuration, including its RFC 6962 witness pins.
MESSENGER_ISSUER_SECURITY_CONFIG='REPLACE_WITH_EXACT_NATIVE_SECURITY_CONFIGURATION'
MESSENGER_CREDIT_USDC_MINT=REPLACE_WITH_PINNED_MINT
MESSENGER_CREDIT_SOLANA_RPC_URL=https://rpc.example
MESSENGER_CREDIT_SOL_PRICE_ACCOUNT=REPLACE_WITH_PINNED_PYTH_SOL_USD_ACCOUNT
MESSENGER_DELIVERY_INTERNAL_URL=https://core.example
MESSENGER_CREDIT_ADMIN_TRANSPORT=ingress
MESSENGER_CREDIT_ISSUER_INTERNAL_TOKEN=REPLACE_WITH_DISTINCT_ISSUER_ADMIN_TOKEN
MESSENGER_CREDIT_PURCHASE_INTERNAL_TOKEN=REPLACE_WITH_DISTINCT_EDGE_PURCHASE_TOKEN
MESSENGER_TREASURY_GENESIS=REPLACE_WITH_CLUSTER_GENESIS_BASE58
MESSENGER_TREASURY_RPC_A=https://rpc-a.example
MESSENGER_TREASURY_RPC_B=https://rpc-b.example
MESSENGER_TREASURY_OWNER=REPLACE_WITH_SEPARATELY_HELD_TREASURY_OWNER
MESSENGER_TREASURY_FEE_PAYER=REPLACE_WITH_PROVISIONED_FEE_PAYER
MESSENGER_TREASURY_NONCE_AUTHORITY=REPLACE_WITH_PROVISIONED_NONCE_AUTHORITY
MESSENGER_TREASURY_NONCE_ACCOUNT=REPLACE_WITH_INITIALIZED_NONCE_ACCOUNT
MESSENGER_TREASURY_REWARDS_PROGRAM=REPLACE_WITH_PINNED_REWARDS_PROGRAM
MESSENGER_TREASURY_REWARDS_POOL=REPLACE_WITH_DERIVED_REWARDS_POOL
