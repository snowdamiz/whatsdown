@@ -491,6 +491,20 @@
 
 # Read-only local context for a queued message request. Duplicate message IDs
 # across different conversations are ambiguous and never select a recipient.
+fn history_contains_message(entries :: List<MobileHistoryEntry>,
+  message_id :: Bytes,
+  local_account_id :: Bytes,
+  index :: Int) -> Bool do
+  if index >= List.length(entries) do
+    false
+  else
+    let entry = List.get(entries, index)
+    (Bytes.secure_equals(entry.inner.client_message_id, message_id)
+      && Bytes.secure_equals(entry.inner.sender_account_id, local_account_id))
+      || history_contains_message(entries, message_id, local_account_id, index + 1)
+  end
+end
