{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "image": "sdk-58",
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "sdk-58"
      },
      "buildArtifactPaths": [
        "plaintext-release"
      ],
      "env": {
        "MORSE_PLAINTEXT_EVIDENCE": "1",
        "MORSE_RELEASE_REPOSITORY": "snowdamiz/whatsdown"
      }
    },
    "staging": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
