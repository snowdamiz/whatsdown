{
  "name": "morse-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "postinstall": "node scripts/harden-expo-notifications-autolinking.mjs",
    "eas-build-pre-install": "bash ../../scripts/eas-build-native.sh",
    "render-icons": "node scripts/render-icons.mjs",
    "typecheck": "tsc --noEmit",
    "check:native-network": "node scripts/native-network-inventory.mjs",
    "messages": "node scripts/messages.mjs",
    "test:preview-bundles": "node scripts/test-preview-bundles.mjs",
    "test:startup": "node scripts/test-startup.mjs",
    "test:anchor-status": "node scripts/test-anchor-status.mjs",
    "test:filing-status": "node scripts/test-filing-status.mjs",
    "test:credits": "node scripts/test-credits.mjs",
    "test:credit-signup": "node scripts/test-credit-signup.mjs",
    "test": "node --experimental-strip-types --experimental-vm-modules --test src/*.test.ts scripts/*.test.mjs",
    "test:attachments": "node scripts/test-attachments.mjs",
    "test:bounties": "node scripts/test-bounties.mjs",
    "test:postage": "node scripts/test-postage.mjs",
    "test:paid-attachments": "node scripts/test-paid-attachments.mjs",
    "test:paid-downloads": "node scripts/test-paid-downloads.mjs",
    "test:profiles": "node scripts/test-profiles.mjs",
    "test:account-deletion": "node scripts/test-account-deletion.mjs",
    "test:receipts": "node scripts/test-receipts.mjs",
    "test:communities": "node scripts/test-communities.mjs",
    "test:notifications": "node scripts/test-unread.mjs --notifications",
    "eas-build-on-success": "node ../../scripts/plaintext-release.mjs worker-success",
    "test:network-counter": "node --experimental-strip-types scripts/test-network-counter.mjs",
    "test:safety-qr": "node scripts/test-safety-qr.mjs",
    "test:request-row": "node scripts/test-request-row.mjs",
    "test:attachment-cleanup": "node scripts/test-attachment-cleanup.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/geist-mono": "0.4.3",
    "@expo/ui": "~58.0.21",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-notification": "2.4.0",
    "expo": "~58.0.16",
    "expo-camera": "~58.0.11",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-localization": "~58.0.5",
    "expo-notifications": "58.1.5",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.63.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "@expo/ui"
        ]
      }
    }
  },
  "overrides": {
    "react-native-qrcode-svg": {
      "text-encoding": "npm:@zxing/text-encoding@0.9.0"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
