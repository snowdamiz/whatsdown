{
  "name": "whatsdown-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "postinstall": "node scripts/harden-expo-notifications-autolinking.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts scripts/*.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "expo": "~57.0.18",
    "expo-camera": "~57.0.4",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-notifications": "57.0.15",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-qrcode-svg": {
      "text-encoding": "npm:@zxing/text-encoding@0.9.0"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
