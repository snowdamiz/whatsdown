from Api.Binary import publish_prekeys_request

fn exercise() -> Result<(), String> do
  let pool = Pool.open(Env.get("MESSENGER_TEST_DATABASE_URL", ""), 1, 2, 5000)?
  let wire = case Bytes.from_hex(Env.get("M6_ROLLOUT_OTB", "")) do
    Err(_) -> Err("OTB decode failed")
    Ok(value)
  end?
  let response = publish_prekeys_request(pool, wire)
  let expected_status = if Env.get("M6_EXPECT_OLD_ACTIVE", "0") == "1" do
    201
  else
    200
  end
  if response.status != expected_status do
    println("old writer status=" <> Int.to_string(response.status))
    return Err("old writer publication did not replay")
  end
  let rows = Pool.query(pool,
    "SELECT count(*)::text AS n FROM messenger_one_time_prekeys WHERE prekey_id = 9 AND consumed_at IS NULL",
    [])?
  if Map.get(List.head(rows), "n") != Env.get("M6_EXPECT_OLD_ACTIVE", "0") do
    return Err("old writer activation boundary differed")
  end
  Pool.close(pool)
  Ok(nil)
end

fn main() do
  case exercise() do
    Err(error) -> do
      println(error)
      Process.exit(1)
    end
    Ok(_) -> println("old writer boundary observed")
  end
end
